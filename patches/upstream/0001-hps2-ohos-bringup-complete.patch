--- /dev/null
+++ b/pcsx2/MTVUNotificationBatch.h
@@ -0,0 +1,24 @@
+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+#pragma once
+
+// Producer-owned policy only: it never reads or changes WorkSema's sleep state.
+// ExecuteVU, other commands, backpressure and WaitVU must flush deferred work.
+class MTVUNotificationBatch
+{
+	unsigned m_unpacks = 0;
+	bool m_pending = false;
+
+public:
+	static constexpr unsigned MaxDeferredUnpacks = 8;
+	bool OnUnpack()
+	{
+		// Wake for the first packet so unpack can overlap EE packet building.
+		// Then bound the deferred tail without inspecting the worker's state.
+		const bool notify = (m_unpacks++ % MaxDeferredUnpacks) == 0;
+		m_pending = !notify;
+		return notify;
+	}
+	bool HasPending() const { return m_pending; }
+	void OnNotify() { m_unpacks = 0; m_pending = false; }
+};
diff --git a/pcsx2/MTVURingCredit.h b/pcsx2/MTVURingCredit.h
new file mode 100644
index 000000000..bb5624b57
--- /dev/null
+++ b/pcsx2/MTVURingCredit.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-3.0+
+#pragma once
+
+#include <cstdint>
+
+// EE-owned conservative credit. Absolute progress disambiguates a wrapped
+// consumer from an older lap; cached progress can only underestimate space.
+template<std::uint32_t Capacity, std::uint32_t SafetyWords = 0>
+class MTVURingCredit
+{
+	static_assert(Capacity && !(Capacity & (Capacity - 1)));
+	static_assert(SafetyWords + 1 < Capacity);
+	std::uint64_t written = 0;
+	std::uint64_t consumed = 0;
+
+public:
+	static constexpr std::uint32_t Usable = Capacity - SafetyWords - 1;
+	static constexpr std::uint64_t Advance(std::uint64_t sequence, std::uint32_t next)
+	{
+		const std::uint32_t previous = static_cast<std::uint32_t>(sequence) & (Capacity - 1);
+		return sequence + ((next - previous) & (Capacity - 1));
+	}
+	void Reset() { written = consumed = 0; }
+	void PublishTo(std::uint32_t next) { written = Advance(written, next); }
+	void Refresh(std::uint64_t observed) { consumed = observed; }
+	bool HasSpace(std::uint32_t words) const
+	{
+		return words <= Usable && written - consumed <= Usable - words;
+	}
+	std::uint64_t Written() const { return written; }
+};
