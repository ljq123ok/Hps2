diff --git a/pcsx2/GS/Renderers/OpenGL/GLContextEGLOHOS.cpp b/pcsx2/GS/Renderers/OpenGL/GLContextEGLOHOS.cpp
new file mode 100644
index 0000000000..430cf311c6
--- /dev/null
+++ b/pcsx2/GS/Renderers/OpenGL/GLContextEGLOHOS.cpp
@@ -0,0 +1,116 @@
+// SPDX-FileCopyrightText: 2026 Hps2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+#include "GLContextEGLOHOS.h"
+
+#include "common/Console.h"
+
+#include <native_window/external_window.h>
+
+#include <EGL/egl.h>
+
+GLContextEGLOHOS::GLContextEGLOHOS(const WindowInfo& wi) : GLContextEGL(wi) {}
+GLContextEGLOHOS::~GLContextEGLOHOS() = default;
+
+std::unique_ptr<GLContext> GLContextEGLOHOS::Create(const WindowInfo& wi, const Version* versions_to_try,
+	size_t num_versions_to_try)
+{
+	std::unique_ptr<GLContextEGLOHOS> context = std::make_unique<GLContextEGLOHOS>(wi);
+	if (!context->Initialize(std::span<const Version>(versions_to_try, num_versions_to_try), nullptr))
+		return nullptr;
+
+	return context;
+}
+
+std::unique_ptr<GLContext> GLContextEGLOHOS::CreateSharedContext(const WindowInfo& wi, Error* error)
+{
+	std::unique_ptr<GLContextEGLOHOS> context = std::make_unique<GLContextEGLOHOS>(wi);
+	context->m_display = m_display;
+
+	if (!context->CreateContextAndSurface(m_version, m_context, false))
+		return nullptr;
+
+	return context;
+}
+
+void GLContextEGLOHOS::ResizeSurface(u32 new_surface_width, u32 new_surface_height)
+{
+	// ---------------------------------------------------------------------
+	// 为什么必须在这里重建 EGL surface（而不是只更新尺寸字段）
+	//
+	// 上游 GLContextEGL::ResizeSurface() 只做一件事：把新尺寸写进 m_wi
+	// （GLContextEGL.cpp:343-344），**不重建 EGLSurface**。
+	// 对桌面平台这没问题 —— 窗口系统的 surface 会自己跟着窗口变。
+	//
+	// 但在 HarmonyOS 上，底层是 OHNativeWindow：旋转或改变窗口尺寸时，
+	// 它的图形缓冲区会换成新尺寸，而 EGLSurface 仍绑在旧缓冲上。
+	// 结果是呈现时尺寸不匹配 —— 真机表现为**黑屏**
+	// （模拟器仍在跑：emulog 里 PerfLog 62fps、GS 在编译着色器）。
+	//
+	// 因此这里销毁旧 surface 并按新尺寸重建。
+	// 尺寸本身仍交给基类处理，保持一致。
+	// ---------------------------------------------------------------------
+	const bool size_changed =
+		(new_surface_width != 0 && new_surface_height != 0 &&
+			(new_surface_width != m_wi.surface_width || new_surface_height != m_wi.surface_height));
+
+	GLContextEGL::ResizeSurface(new_surface_width, new_surface_height);
+
+	if (!size_changed)
+		return;
+
+	// 没有 window / display 的场合（例如 Surfaceless）无需重建
+	if (m_display == EGL_NO_DISPLAY || m_surface == EGL_NO_SURFACE || !m_wi.window_handle)
+		return;
+
+	OHNativeWindow* window = static_cast<OHNativeWindow*>(m_wi.window_handle);
+	EGLNativeWindowType native_window = reinterpret_cast<EGLNativeWindowType>(window);
+	if (!native_window)
+		return;
+
+	// 先解绑并销毁旧 surface，再按同一 config 重建
+	eglMakeCurrent(m_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+	if (!eglDestroySurface(m_display, m_surface))
+		Console.WarningFmt("GLContextEGLOHOS: eglDestroySurface() failed: 0x{:x}", eglGetError());
+
+	m_surface = eglCreateWindowSurface(m_display, m_config, native_window, nullptr);
+	if (m_surface == EGL_NO_SURFACE)
+	{
+		Console.ErrorFmt("GLContextEGLOHOS: eglCreateWindowSurface() failed on resize: 0x{:x} "
+		                 "(size {}x{})", eglGetError(), m_wi.surface_width, m_wi.surface_height);
+		return;
+	}
+
+	// 重新绑定上下文到新 surface，否则后续绘制会落到已销毁的旧 surface
+	if (!eglMakeCurrent(m_display, m_surface, m_surface, m_context))
+	{
+		Console.ErrorFmt("GLContextEGLOHOS: eglMakeCurrent() failed after resize: 0x{:x}",
+			eglGetError());
+		return;
+	}
+
+	Console.WriteLn("GLContextEGLOHOS: EGL surface recreated at %ux%u after window resize",
+		m_wi.surface_width, m_wi.surface_height);
+}
+
+EGLNativeWindowType GLContextEGLOHOS::GetNativeWindow(EGLConfig)
+{
+	OHNativeWindow* window = static_cast<OHNativeWindow*>(m_wi.window_handle);
+	if (!window)
+	{
+		Console.Error("GLContextEGLOHOS: no OHNativeWindow in WindowInfo (frontend did not supply one)");
+		return 0;
+	}
+
+	if (m_wi.surface_width == 0 || m_wi.surface_height == 0)
+	{
+		Console.Warning("GLContextEGLOHOS: window is %ux%u, expected the frontend to supply "
+		                "the size from OH_NativeXComponent_GetXComponentSize",
+			m_wi.surface_width, m_wi.surface_height);
+	}
+
+	Console.WriteLn("GLContextEGLOHOS: using OHNativeWindow %p, surface %ux%u",
+		static_cast<void*>(window), m_wi.surface_width, m_wi.surface_height);
+
+	return static_cast<EGLNativeWindowType>(window);
+}
