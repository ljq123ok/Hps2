 target_link_libraries(common PRIVATE
 	${LIBC_LIBRARIES}
 	JPEG::JPEG
diff --git a/common/HTTPDownloaderOHOS.cpp b/common/HTTPDownloaderOHOS.cpp
new file mode 100644
index 000000000..478d54491
--- /dev/null
+++ b/common/HTTPDownloaderOHOS.cpp
@@ -0,0 +1,220 @@
+/*
+ * Hps2 — HarmonyOS (OHOS) 原生 HTTPDownloader
+ *
+ * 为什么需要它：
+ *   ARMSX2 在非 Windows 平台默认使用 HTTPDownloaderCurl（依赖 libcurl）。
+ *   OHOS sysroot **不提供 libcurl**，而上游 cmake/SearchForStuff.cmake 的
+ *   else() 分支无条件 find_package(CURL REQUIRED)，导致配置失败。
+ *   上游 Android 平台的做法是另写 HTTPDownloaderAndroid（经 JNI 走 Java
+ *   HttpClient）以绕开 curl。OHOS 采用同思路，但**不用 JNI** ——
+ *   OHOS 提供纯 C 的原生 HTTP 接口（network/netstack/net_http.h，
+ *   since API 20），直接使用，无需经过 ArkTS/Java 层。
+ *
+ * API 事实（已核对 net_http.h / net_http_type.h，非推测）：
+ *   Http_Request *OH_Http_CreateRequest(const char *url);
+ *   int  OH_Http_Request(Http_Request*, Http_ResponseCallback, Http_EventsHandler);
+ *   void OH_Http_Destroy(Http_Request**);
+ *   回调签名均**不带 userdata**：
+ *     void (*Http_ResponseCallback)(Http_Response*, uint32_t errCode);
+ *     void (*Http_OnDataReceiveCallback)(const char *data, size_t length);
+ *   响应体位于 Http_Response.body（{const char* buffer; uint32_t length;}）。
+ *
+ * 因回调无 userdata，无法在回调间传递上下文。本实现的处理方式：
+ *   用 thread_local 指针记录"当前线程正在处理的请求累积器"。
+ *   OH_Http_Request 在工作线程内同步完成、回调亦在该线程触发，
+ *   因此 thread_local 是安全且正确的上下文载体。
+ *
+ * 已知限制（明确声明，非静默降级）：
+ *   POST 未实现 —— 返回失败，而不是静默当作 GET 发出。
+ *   当前 PCSX2 的成就/资源下载路径均为 GET，不影响阶段 2 目标。
+ */
+
+#include "common/HTTPDownloader.h"
+
+#include "common/Console.h"
+
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "fmt/format.h"
+
+#include <network/netstack/net_http.h>
+
+namespace {
+
+struct ResponseAccumulator
+{
+	std::vector<u8> body;
+	std::string content_type;
+};
+
+// 回调不带 userdata，故用 thread_local 承接当前请求的上下文。
+thread_local ResponseAccumulator* t_acc = nullptr;
+
+void OnDataReceive(const char* data, size_t length)
+{
+	if (t_acc == nullptr || data == nullptr || length == 0)
+		return;
+
+	const auto* bytes = reinterpret_cast<const u8*>(data);
+	t_acc->body.insert(t_acc->body.end(), bytes, bytes + length);
+}
+
+void OnResponse(Http_Response* response, uint32_t errCode)
+{
+	if (t_acc == nullptr || errCode != 0 || response == nullptr)
+		return;
+
+	if (response->headers != nullptr)
+	{
+		if (Http_HeaderValue* v = OH_Http_GetHeaderValue(response->headers, "content-type"))
+		{
+			if (v->value != nullptr)
+				t_acc->content_type = v->value;
+		}
+	}
+
+	// 兜底：若 onDataReceive 未触发，则从 body 直接取一次
+	if (t_acc->body.empty() && response->body.buffer != nullptr && response->body.length > 0)
+	{
+		const auto* bytes = reinterpret_cast<const u8*>(response->body.buffer);
+		t_acc->body.assign(bytes, bytes + response->body.length);
+	}
+}
+
+} // namespace
+
+class HTTPDownloaderOHOS final : public HTTPDownloader
+{
+public:
+	HTTPDownloaderOHOS() = default;
+	~HTTPDownloaderOHOS() override;
+
+	bool Initialize(std::string user_agent);
+
+protected:
+	Request* InternalCreateRequest() override;
+	void InternalPollRequests() override;
+	bool StartRequest(Request* request) override;
+	void CloseRequest(Request* request) override;
+
+private:
+	struct OHOSRequest final : public Request
+	{
+		std::thread worker;
+		std::string result_content_type;
+		Request::Data result_data;
+	};
+
+	std::string m_user_agent;
+};
+
+HTTPDownloaderOHOS::~HTTPDownloaderOHOS()
+{
+	std::unique_lock<std::mutex> lock(m_pending_http_request_lock);
+	for (Request* req : m_pending_http_requests)
+	{
+		auto* oreq = static_cast<OHOSRequest*>(req);
+		if (oreq->worker.joinable())
+			oreq->worker.join();
+	}
+}
+
+bool HTTPDownloaderOHOS::Initialize(std::string user_agent)
+{
+	m_user_agent = std::move(user_agent);
+	Console.WriteLn("HTTPDownloaderOHOS: using HarmonyOS native net_http (no libcurl needed)");
+	return true;
+}
+
+HTTPDownloader::Request* HTTPDownloaderOHOS::InternalCreateRequest()
+{
+	return new OHOSRequest();
+}
+
+void HTTPDownloaderOHOS::InternalPollRequests()
+{
+	// 工作线程完成时置 state=Complete，
+	// 基类轮询观察到原子状态变化后触发回调，无需额外协调。
+}
+
+bool HTTPDownloaderOHOS::StartRequest(Request* request)
+{
+	auto* oreq = static_cast<OHOSRequest*>(request);
+
+	// 明确拒绝 POST，而非静默当作 GET
+	if (oreq->type == Request::Type::Post)
+	{
+		Console.Error("HTTPDownloaderOHOS: POST is not implemented on the OHOS native path");
+		return false;
+	}
+
+	oreq->state.store(Request::State::Started);
+	const std::string url = oreq->url;
+	const std::string ua = m_user_agent;
+
+	oreq->worker = std::thread([oreq, url, ua]() {
+		auto acc = std::make_unique<ResponseAccumulator>();
+		t_acc = acc.get();
+
+		Http_Request* req = OH_Http_CreateRequest(url.c_str());
+		if (req == nullptr)
+		{
+			Console.Error(fmt::format("HTTPDownloaderOHOS: OH_Http_CreateRequest failed: {}", url));
+			t_acc = nullptr;
+			oreq->state.store(Request::State::Complete);
+			return;
+		}
+
+		if (req->options != nullptr)
+		{
+			if (Http_Headers* h = OH_Http_CreateHeaders())
+			{
+				if (!ua.empty())
+					OH_Http_SetHeaderValue(h, "User-Agent", ua.c_str());
+				req->options->headers = h;
+			}
+			req->options->connectTimeout = 30000; // ms
+			req->options->readTimeout = 30000;
+		}
+
+		Http_EventsHandler handler{};
+		handler.onDataReceive = &OnDataReceive;
+
+		const int ret = OH_Http_Request(req, &OnResponse, handler);
+		if (ret != 0)
+		{
+			Console.Error(fmt::format("HTTPDownloaderOHOS: OH_Http_Request failed ret={} url={}", ret, url));
+			OH_Http_Destroy(&req);
+			t_acc = nullptr;
+			oreq->state.store(Request::State::Complete);
+			return;
+		}
+
+		OH_Http_Destroy(&req);
+
+		oreq->result_content_type = acc->content_type;
+		oreq->result_data = std::move(acc->body);
+		t_acc = nullptr;
+		oreq->state.store(Request::State::Complete);
+	});
+
+	return true;
+}
+
+void HTTPDownloaderOHOS::CloseRequest(Request* request)
+{
+	auto* oreq = static_cast<OHOSRequest*>(request);
+	if (oreq->worker.joinable())
+		oreq->worker.join();
+}
+
+std::unique_ptr<HTTPDownloader> HTTPDownloader::Create(std::string user_agent)
+{
+	auto inst = std::make_unique<HTTPDownloaderOHOS>();
+	if (!inst->Initialize(std::move(user_agent)))
+		return {};
+	return inst;
+}
diff --git a/common/HarmonyOS/ohos_libcxx_compat.h b/common/HarmonyOS/ohos_libcxx_compat.h
new file mode 100644
index 000000000..4f3bac42f
--- /dev/null
+++ b/common/HarmonyOS/ohos_libcxx_compat.h
@@ -0,0 +1,242 @@
+/*
+ * Hps2 — HarmonyOS (OHOS) C++ 标准库补丁
+ *
+ * 背景：
+ *   OHOS 的 libc++ 为 15004（LLVM 15），其 <algorithm> **不提供**
+ *   C++20 的 std::lexicographical_compare_three_way。
+ *
+ * 已实测确认（非推测）：
+ *   - 该函数在 OHOS toolchain 下编译报
+ *       error: no member named 'lexicographical_compare_three_way' in namespace 'std'
+ *   - 同样的代码在宿主 macOS 上编译通过（HOST EXIT=0）
+ *   - OHOS 的 <compare> **存在**，且运算符 **<=> 可用**
+ *     （实测 (1 <=> 2) 编译通过）
+ *   - libc++ 的 <version> 中 __cpp_lib_three_way_comparison 被注释掉，
+ *     说明该库的 three-way comparison 支持不完整
+ *
+ * 因此本补丁**只补缺失的那一个函数**，不改变上游代码的语义：
+ *   operator<=> 的实现本就期望返回一个与 0 可比较的比较结果，
+ *   这里用等价的 std::compare_three_way 逐元素比较实现，
+ *   对满足 three-way-comparable 的类型与原标准实现语义一致。
+ *
+ * 仅在 OHOS 上生效；其他平台继续使用标准库实现。
+ */
+
+#pragma once
+
+#if defined(__OHOS__)
+
+#include <algorithm>
+#include <array>
+#include <compare>
+#include <iterator>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace std
+{
+
+// C++20 std::lexicographical_compare_three_way 的等价实现。
+// 语义：按字典序比较两个区间，返回首个不等元素的比较结果；
+//       若一方是另一方的前缀，则较短者更小。
+template <class InputIt1, class InputIt2, class Cmp = compare_three_way>
+constexpr auto lexicographical_compare_three_way(
+	InputIt1 first1, InputIt1 last1,
+	InputIt2 first2, InputIt2 last2,
+	Cmp comp = Cmp{})
+	-> decltype(comp(*first1, *first2))
+{
+	using ret_type = decltype(comp(*first1, *first2));
+
+	for (; first1 != last1 && first2 != last2; ++first1, ++first2)
+	{
+		if (auto cmp_result = comp(*first1, *first2); cmp_result != 0)
+			return cmp_result;
+	}
+
+	// 前缀关系：长度更短的一方更小
+	if (first1 == last1 && first2 == last2)
+		return ret_type::equivalent;
+
+	// 借助 strong_ordering 表达"短者小"
+	return (first1 == last1) ? ret_type::less : ret_type::greater;
+}
+
+} // namespace std
+
+
+
+// ---------------------------------------------------------------------------
+// 第二部分：补齐标准容器/字符串的 operator<=>
+//
+// 实测发现 OHOS libc++ 15004 的 three-way comparison 支持**不完整**：
+//   std::pair       ✅ 有
+//   std::tuple      ✅ 有
+//   std::vector     ❌ 无
+//   std::string     ❌ 无
+//   std::array      ❌ 无
+//   std::optional   ❌ 无
+//
+// 影响：任何 `operator<=> = default` 且成员含上述类型的结构体，
+// 其 <=> 会被**隐式删除**，导致编译失败。实测样例：
+//   pcsx2/Config.h:1395
+//     note: defaulted 'operator<=>' is implicitly deleted because there is no
+//           viable three-way comparison function for member 'SymbolSources'
+//           std::vector<DebugSymbolSource> SymbolSources;
+//
+// 这里为缺失的类型补上等价实现。选择补类型而非改调用点，理由：
+//   1. 修的是根因，新增代码自动受益，不必逐个追改；
+//   2. 上游 4 处 defaulted <=> 无需改动，减少与上游分叉；
+//   3. 语义与标准库一致（字符串比较用 compare()，容器用字典序）。
+// ---------------------------------------------------------------------------
+
+namespace std
+{
+
+inline strong_ordering operator<=>(const string& lhs, const string& rhs)
+{
+	const int r = lhs.compare(rhs);
+	return (r < 0) ? strong_ordering::less : ((r > 0) ? strong_ordering::greater : strong_ordering::equal);
+}
+
+template <class T, class Alloc>
+inline auto operator<=>(const vector<T, Alloc>& lhs, const vector<T, Alloc>& rhs)
+{
+	return lexicographical_compare_three_way(lhs.begin(), lhs.end(), rhs.begin(), rhs.end());
+}
+
+template <class T, size_t N>
+inline auto operator<=>(const array<T, N>& lhs, const array<T, N>& rhs)
+{
+	return lexicographical_compare_three_way(lhs.begin(), lhs.end(), rhs.begin(), rhs.end());
+}
+
+template <class T>
+inline auto operator<=>(const optional<T>& lhs, const optional<T>& rhs)
+{
+	if (lhs.has_value() != rhs.has_value())
+		return lhs.has_value() ? strong_ordering::greater : strong_ordering::less;
+	if (!lhs.has_value())
+		return strong_ordering::equal;
+	return *lhs <=> *rhs;
+}
+
+} // namespace std
+
+
+
+// ---------------------------------------------------------------------------
+// 第三部分：补齐缺失的 C++20 工厂函数
+//
+// 实测确认 OHOS libc++ 15004 缺少 std::make_unique_for_overwrite
+// （宿主 clang 21 可用，OHOS 编译报
+//   "no member named 'make_unique_for_overwrite' in namespace 'std'"）。
+// 工程内共 7 处使用（GSLzma / AdapterUtils / FlatFileReader / ChdFileReader 等）。
+//
+// 语义差异说明：标准实现用 new T（默认初始化，标量不置零），
+// 比 make_unique 的 new T() 更快。补的实现保持同样语义：
+//   - 数组形式用 new T[n]（默认初始化）
+//   - 单对象形式用 new T（默认初始化）
+// 调用方只是拿一块未初始化缓冲来填，语义一致。
+// ---------------------------------------------------------------------------
+
+namespace std
+{
+
+template <class T>
+inline unique_ptr<T> make_unique_for_overwrite()
+{
+	return unique_ptr<T>(new T);
+}
+
+template <class T>
+inline unique_ptr<T> make_unique_for_overwrite(size_t n)
+{
+	return unique_ptr<T>(new remove_extent_t<T>[n]);
+}
+
+} // namespace std
+
+
+
+// ---------------------------------------------------------------------------
+// 第四部分：补齐缺失的 std::ranges 算法
+//
+// 实测确认 OHOS libc++ 15004 缺少下列 <algorithm> 的 ranges 版本
+// （宿主 clang 21 可用）。工程内实际用到 3 个，全部缺失。
+//
+// 需要的重载形式（按实际调用点确定，非猜测）：
+//   all_of       range 形式      all_of(ids, pred)
+//   stable_sort  range 形式      stable_sort(slots, comp)
+//   equal        iterator 形式   equal(f1, l1, f2, l2, pred)
+// 为稳妥起见，两种形式都提供。
+//
+// 实现方式：直接转调对应的迭代器版本（std::all_of / std::equal /
+// std::stable_sort），不重新实现算法，语义一致。
+// ---------------------------------------------------------------------------
+
+namespace std::ranges
+{
+
+// ---- all_of：range 形式 + iterator 形式 ----
+template <class Range, class Pred>
+inline constexpr bool all_of(Range&& r, Pred pred)
+{
+	return std::all_of(std::begin(r), std::end(r), pred);
+}
+
+template <class InputIt, class Pred>
+inline constexpr bool all_of(InputIt first, InputIt last, Pred pred)
+{
+	return std::all_of(first, last, pred);
+}
+
+// ---- equal：iterator 形式（含谓词）+ range 形式 ----
+template <class InputIt1, class InputIt2>
+inline constexpr bool equal(InputIt1 first1, InputIt1 last1, InputIt2 first2, InputIt2 last2)
+{
+	return std::equal(first1, last1, first2, last2);
+}
+
+template <class InputIt1, class InputIt2, class Pred>
+inline constexpr bool equal(InputIt1 first1, InputIt1 last1, InputIt2 first2, InputIt2 last2, Pred pred)
+{
+	return std::equal(first1, last1, first2, last2, pred);
+}
+
+template <class Range1, class Range2>
+inline constexpr bool equal(Range1&& r1, Range2&& r2)
+{
+	return std::equal(std::begin(r1), std::end(r1), std::begin(r2), std::end(r2));
+}
+
+// ---- stable_sort：range 形式 + iterator 形式 ----
+template <class Range, class Comp>
+inline void stable_sort(Range&& r, Comp comp)
+{
+	std::stable_sort(std::begin(r), std::end(r), comp);
+}
+
+template <class Range>
+inline void stable_sort(Range&& r)
+{
+	std::stable_sort(std::begin(r), std::end(r));
+}
+
+template <class RandIt, class Comp>
+inline void stable_sort(RandIt first, RandIt last, Comp comp)
+{
+	std::stable_sort(first, last, comp);
+}
+
+template <class RandIt>
+inline void stable_sort(RandIt first, RandIt last)
+{
+	std::stable_sort(first, last);
+}
+
+} // namespace std::ranges
+
+#endif // __OHOS__
