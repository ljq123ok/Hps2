+	ASSERT_TRUE(RecompilerTestEnvironment::IsReady());
+	const bool was_open = vu1Thread.IsOpen();
+	if (was_open) { vu1Thread.WaitVU(); vu1Thread.Close(); }
+	struct RestoreThread
+	{
+		bool was_open;
+		~RestoreThread() { vu1Thread.Close(); if (was_open) vu1Thread.Open(); }
+	} restore{was_open};
+	std::array<u32, VU1_MEMSIZE / sizeof(u32)> payload{}, expected{};
+	for (unsigned session = 0; session < 2; ++session)
+	{
+		vu1Thread.Open();
+		std::memset(VU1.Mem, 0, VU1_MEMSIZE);
+		expected.fill(0);
+		for (unsigned n = 0; n < 20000; ++n)
+		{
+			const unsigned words = 1 + (n * 137u % payload.size());
+			for (unsigned i = 0; i < words; ++i) payload[i] = n ^ (i * 0x9e3779b9u) ^ session;
+			std::memcpy(expected.data(), payload.data(), words * sizeof(u32));
+			vu1Thread.WriteDataMem(0, payload.data(), words * sizeof(u32));
+			if (n % 97 == 0)
+			{
+				vu1Thread.WaitVU();
+				ASSERT_TRUE(vu1Thread.IsDone());
+				ASSERT_EQ(std::memcmp(expected.data(), VU1.Mem, VU1_MEMSIZE), 0) << n;
+			}
+		}
+		vu1Thread.WaitVU();
+		EXPECT_TRUE(vu1Thread.IsDone());
+		EXPECT_EQ(std::memcmp(expected.data(), VU1.Mem, VU1_MEMSIZE), 0);
+		vu1Thread.Close();
+	}
+}
