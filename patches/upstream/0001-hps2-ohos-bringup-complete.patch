diff --git a/cmake/ohos.toolchain.cmake b/cmake/ohos.toolchain.cmake
new file mode 100644
index 000000000..d4338835d
--- /dev/null
+++ b/cmake/ohos.toolchain.cmake
@@ -0,0 +1,126 @@
+# HarmonyOS (OHOS) 交叉编译 toolchain for ARMSX2 / Hps2
+#
+# 设计原则：
+#   1. 不做"猜宏"式移植 —— OHOS 定义 __OHOS__ + __linux__，
+#      不定义 __ANDROID__/__APPLE__/_WIN32，因此上游会把它当普通 Linux，
+#      从而拉入 D-Bus / X11 / libcurl。这些在本 toolchain 中被显式关闭。
+#   2. 尽量复用上游构建系统，不手工维护源文件列表。
+#
+# 用法：
+#   cmake -DCMAKE_TOOLCHAIN_FILE=<this file> ...
+
+set(CMAKE_SYSTEM_NAME OHOS)
+set(CMAKE_SYSTEM_PROCESSOR aarch64)
+
+# --- SDK 定位 ---
+if(NOT DEFINED OHOS_SDK_NATIVE)
+    set(OHOS_SDK_NATIVE "/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/native")
+endif()
+
+set(OHOS_TOOLCHAIN "${OHOS_SDK_NATIVE}/llvm")
+set(OHOS_SYSROOT   "${OHOS_SDK_NATIVE}/sysroot")
+
+set(CMAKE_C_COMPILER   "${OHOS_TOOLCHAIN}/bin/clang")
+set(CMAKE_CXX_COMPILER "${OHOS_TOOLCHAIN}/bin/clang++")
+set(CMAKE_AR           "${OHOS_TOOLCHAIN}/bin/llvm-ar"      CACHE FILEPATH "")
+set(CMAKE_RANLIB       "${OHOS_TOOLCHAIN}/bin/llvm-ranlib"  CACHE FILEPATH "")
+set(CMAKE_STRIP        "${OHOS_TOOLCHAIN}/bin/llvm-strip"   CACHE FILEPATH "")
+
+set(CMAKE_SYSROOT "${OHOS_SYSROOT}")
+
+# --- 编译/链接标志 ---
+# --target 与 sysroot 必须成对出现，否则会误用宿主 libc
+add_compile_options(
+    --target=aarch64-linux-ohos
+    -D__OHOS__=1
+)
+add_link_options(--target=aarch64-linux-ohos)
+
+# OHOS 使用 musl libc；与 glibc 的差异（如缺少 _SC_LEVEL1_*CACHE_LINESIZE）
+# 由平台层在源码内适配，这里只做能力声明。
+add_compile_definitions(
+    __MUSL__=1
+    OHOS_PLATFORM=1
+)
+
+# --- 查找行为 ---
+#
+# 必须把 sysroot 与"第三方库安装前缀"都放进搜索根，且 MODE 用 BOTH。
+#
+# 实测教训（两个独立子代理分别踩到并报告）：
+#   若只用 MODE_*=ONLY 且 ROOT_PATH 仅含 sysroot，则 CMAKE_PREFIX_PATH
+#   会被 re-root 到 sysroot 之下，导致已交叉编译好的第三方库
+#   （lz4/libjpeg/libpng/webp/freetype/zstd）全部不可见，报错形如
+#       Could NOT find JPEG (missing: JPEG_LIBRARY JPEG_INCLUDE_DIR)
+#       Could NOT find Freetype (missing: FREETYPE_LIBRARY FREETYPE_INCLUDE_DIRS)
+#   ARMSX2 的 cmake/Find*.cmake 走的是 module 模式（find_path/find_library），
+#   它们依赖搜索路径能覆盖我们的前缀。
+#
+# 误链宿主库的风险由 --target=aarch64-linux-ohos + CMAKE_SYSROOT 控制，
+# 不需要靠 ONLY 来兜底。
+set(CMAKE_FIND_ROOT_PATH "${OHOS_SYSROOT}")
+
+# Hps2 第三方依赖前缀（由 thirdparty-ohos/ 交叉编译产出）
+if(NOT DEFINED HPS2_OHOS_PREFIX)
+    set(HPS2_OHOS_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../../thirdparty-ohos/prefix")
+endif()
+if(EXISTS "${HPS2_OHOS_PREFIX}")
+    list(APPEND CMAKE_FIND_ROOT_PATH "${HPS2_OHOS_PREFIX}")
+    list(APPEND CMAKE_PREFIX_PATH "${HPS2_OHOS_PREFIX}")
+    message(STATUS "Hps2: OHOS third-party prefix = ${HPS2_OHOS_PREFIX}")
+else()
+    message(WARNING "Hps2: OHOS third-party prefix not found at ${HPS2_OHOS_PREFIX}; "
+                    "cross-compile the deps in thirdparty-ohos/ first.")
+endif()
+
+# PROGRAM 用 NEVER：构建期需要在宿主执行代码生成器（如 libpng 的 genout）
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
+set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
+
+# --- OHOS 的架构专属目录（关键）---
+#
+# OHOS sysroot 把库放在带架构后缀的子目录里：
+#     usr/lib/aarch64-linux-ohos/       <- 实际位置
+#     usr/include/aarch64-linux-ohos/
+# 而 CMake 默认只找 <root>/usr/lib，因此会出现
+#     Could NOT find ZLIB (missing: ZLIB_LIBRARY)
+# 即便 libz.so 明明就在那里。
+#
+# 设置 CMAKE_LIBRARY_ARCHITECTURE 让 CMake 自动带上该后缀子目录，
+# 一次性修好所有 find_library/find_package，无需逐个手写 hint。
+set(CMAKE_LIBRARY_ARCHITECTURE "aarch64-linux-ohos")
+list(APPEND CMAKE_LIBRARY_PATH "${OHOS_SYSROOT}/usr/lib/aarch64-linux-ohos")
+list(APPEND CMAKE_INCLUDE_PATH "${OHOS_SYSROOT}/usr/include/aarch64-linux-ohos")
+
+# --- 关闭 OHOS 上不存在的可选依赖 ---
+# 这些开关由 Hps2 平台层设定，目的是避免上游 else() 分支拉入不可用依赖。
+set(OHOS_BUILD 1 CACHE BOOL "Building for HarmonyOS" FORCE)
+set(USE_DBUS   OFF CACHE BOOL "D-Bus not available on OHOS" FORCE)
+set(X11_API    OFF CACHE BOOL "X11 not available on OHOS" FORCE)
+set(USE_BACKTRACE OFF CACHE BOOL "libbacktrace unavailable on OHOS" FORCE)
+
+# --- 关键：编译期页大小必须与内核运行时页大小一致 ---
+#
+# 上游 Pcsx2Defs.h 对 ARCH_ARM64 硬编码 __pagesize = 0x4000（16KB），
+# 注释写的是 "Apple Silicon uses 16KB pages" —— 这是把 iOS/macOS 的
+# 假设套用到了所有 ARM64。HarmonyOS 真机实测为 4KB 页
+# （/proc/self/smaps: KernelPageSize/MMUPageSize = 4 kB），
+# 于是 VMManager::PerformEarlyHardwareChecks 报
+#   "Page size mismatch. This build cannot run on your system."
+#
+# 上游已提供 OVERRIDE_HOST_PAGE_SIZE 机制，Android/iOS 前端都用它
+# （见 platforms/android/.../BuildParameters.cmake），OHOS 同样使用。
+#
+# 缓存行大小同样需要覆盖：ARM64 默认 128 字节（同为 Apple 假设），
+# 而 ARM 通用实现通常是 64 字节。
+set(HPS2_OHOS_PAGE_SIZE "0x1000" CACHE STRING "Compile-time OHOS host page size")
+set(HPS2_OHOS_CACHE_LINE_SIZE "64" CACHE STRING "Compile-time OHOS host cache line size")
+
+add_compile_definitions(
+    OVERRIDE_HOST_PAGE_SIZE=${HPS2_OHOS_PAGE_SIZE}
+    OVERRIDE_HOST_CACHE_LINE_SIZE=${HPS2_OHOS_CACHE_LINE_SIZE}
+)
+
+message(STATUS "Hps2: host page size = ${HPS2_OHOS_PAGE_SIZE}, cache line = ${HPS2_OHOS_CACHE_LINE_SIZE}")
