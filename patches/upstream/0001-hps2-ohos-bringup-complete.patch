--- /dev/null
+++ b/pcsx2/GS/Renderers/OpenGL/GLContextEGLOHOS.h
@@ -0,0 +1,26 @@
+// SPDX-FileCopyrightText: 2026 Hps2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+
+#pragma once
+#include "GLContextEGL.h"
+
+/// [Hps2] HarmonyOS/OpenHarmony EGL context.
+///
+/// Mirrors GLContextEGLAndroid: the frontend hands us an OHNativeWindow*
+/// (from an ArkUI XComponent surface callback) via WindowInfo::window_handle
+/// and passes it to EGL as an EGLNativeWindowType.
+class GLContextEGLOHOS final : public GLContextEGL
+{
+public:
+	GLContextEGLOHOS(const WindowInfo& wi);
+	~GLContextEGLOHOS() override;
+
+	static std::unique_ptr<GLContext> Create(const WindowInfo& wi, const Version* versions_to_try,
+		size_t num_versions_to_try);
+
+	std::unique_ptr<GLContext> CreateSharedContext(const WindowInfo& wi, Error* error) override;
+	void ResizeSurface(u32 new_surface_width = 0, u32 new_surface_height = 0) override;
+
+protected:
+	EGLNativeWindowType GetNativeWindow(EGLConfig config) override;
+};
