+/*
+ * Hps2 — HarmonyOS (OHOS) IOCtlSrc stub
+ *
+ * 背景：
+ *   pcsx2/CDVD/CDVDdiscReader.cpp **无条件**编译并引用 IOCtlSrc，
+ *   而 IOCtlSrc 只有三个平台实现：
+ *       CDVD/Linux/IOCtlSrc.cpp     （if(LINUX) 才加入构建）
+ *       CDVD/Darwin/IOCtlSrc.cpp    （if(APPLE) 才加入构建）
+ *       CDVD/Windows/...            （if(WIN32) 才加入构建）
+ *
+ *   我们的 OHOS 平台分支刻意**不设 LINUX**（因为 OHOS 没有 X11/D-Bus 等
+ *   桌面 Linux 依赖，这与上游 Android 分支的取舍一致），因此三个实现
+ *   都不会被编入，链接期出现 IOCtlSrc 的 11 个未定义符号。
+ *
+ * 为什么用 stub 而不是移植 Linux 实现：
+ *   Linux/Darwin 版本通过 ioctl(CDROMREADTOCENTRY) 等接口读取**物理光驱**。
+ *   OHOS 设备没有光驱，也没提供这些 ioctl；照搬只会引入无意义的依赖。
+ *   本项目的游戏镜像加载走 FlatFileReader / ChdFileReader（文件路径），
+ *   与光驱无关。
+ *
+ * 因此这里提供全部接口的"无光驱"实现：所有查询返回失败/空，
+ * 使调用方走各自已有的错误分支，而不是崩溃或产生未定义行为。
+ * 这与"没有光驱"这一事实相符。
+ */
+
+#include "CDVD/CDVDdiscReader.h"
+
+#include "common/Console.h"
+#include "common/Error.h"
+
+// 仅 OHOS 需要本 stub：其他平台由各自的 IOCtlSrc 实现提供。
+#if defined(__OHOS__)
+
+IOCtlSrc::IOCtlSrc(std::string filename)
+	: m_filename(std::move(filename))
+{
+	Console.Warning("IOCtlSrc: optical drive support is not available on HarmonyOS; "
+	                "use a disc image file instead.");
+}
+
+IOCtlSrc::~IOCtlSrc() = default;
+
+bool IOCtlSrc::Reopen(Error* error)
+{
+	if (error)
+		error->SetString("Optical drives are not available on HarmonyOS.");
+	return false;
+}
