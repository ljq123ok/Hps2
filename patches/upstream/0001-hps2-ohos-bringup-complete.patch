diff --git a/3rdparty/glad/include/EGL/eglplatform.h b/3rdparty/glad/include/EGL/eglplatform.h
index 6786afd90..1ff1f3b3e 100644
--- a/3rdparty/glad/include/EGL/eglplatform.h
+++ b/3rdparty/glad/include/EGL/eglplatform.h
@@ -103,6 +103,23 @@ typedef void*                           EGLNativeDisplayType;
 typedef struct egl_native_pixmap_t*     EGLNativePixmapType;
 typedef struct ANativeWindow*           EGLNativeWindowType;
 
+#elif defined(OHOS_PLATFORM)
+
+/* [Hps2] HarmonyOS/OpenHarmony.
+ *
+ * Without this branch OHOS falls through to the generic `__unix__` case below,
+ * which defines EGLNativeWindowType as `khronos_uintptr_t` (an integer). That
+ * makes `static_cast<EGLNativeWindowType>(OHNativeWindow*)` ill-formed and,
+ * worse, would silently truncate the pointer on a platform where the window
+ * really is a pointer. The OHOS EGL header (sysroot
+ * usr/include/EGL/eglplatform.h) defines these as pointers under
+ * OHOS_PLATFORM; keep the two consistent. */
+struct NativeWindow;
+
+typedef void*                   EGLNativeDisplayType;
+typedef void*                   EGLNativePixmapType;
+typedef struct NativeWindow*    EGLNativeWindowType;
+
 #elif defined(USE_OZONE)
 
 typedef intptr_t EGLNativeDisplayType;
