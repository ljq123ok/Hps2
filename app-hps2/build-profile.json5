{
  "app": {
    // 签名材料不入库。请在 DevEco Studio 中配置本机签名，
    // 或使用外部 hap-sign-tool 在构建后签名。
    "products": [
      {
        "name": "default",
        // 本机 SDK 为 HarmonyOS 6.1.1 (API 24)；目标真机为 HarmonyOS 7/API 26。
        // 共享目录配置在运行时由系统处理，保持本机可用的 target SDK。
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry"
    }
  ]
}
