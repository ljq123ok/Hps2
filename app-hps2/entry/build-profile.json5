{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "jitDevelopment",
      "externalNativeOptions": {
        "arguments": "-DHPS2_STORE_BUILD=OFF"
      }
    },
    {
      "name": "storeInterpreter",
      "externalNativeOptions": {
        "arguments": "-DHPS2_STORE_BUILD=ON"
      }
    }
  ],
  "buildModeBinder": [
    {
      "buildModeName": "debug",
      "mappings": [
        {
          "targetName": "default",
          "buildOptionName": "jitDevelopment"
        }
      ]
    },
    {
      "buildModeName": "release",
      "mappings": [
        {
          "targetName": "default",
          "buildOptionName": "storeInterpreter"
        }
      ]
    }
  ],
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    }
  ]
}
